{
  "$defs": {
    "DashboardDataContract": {
      "additionalProperties": true,
      "properties": {
        "agents": {
          "items": {
            "type": "string"
          },
          "title": "Agents",
          "type": "array"
        },
        "e2eLastRun": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "E2Elastrun"
        },
        "e2eRunning": {
          "title": "E2Erunning",
          "type": "boolean"
        },
        "githubOwner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Githubowner"
        },
        "githubRepo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Githubrepo"
        },
        "paused": {
          "title": "Paused",
          "type": "boolean"
        },
        "providerCircuit": {
          "$ref": "#/$defs/ProviderCircuitStatusContract"
        },
        "queueRefreshSeconds": {
          "title": "Queuerefreshseconds",
          "type": "integer"
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Repo"
        },
        "repoRoot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reporoot"
        },
        "startupComplete": {
          "title": "Startupcomplete",
          "type": "boolean"
        },
        "techLeadActivity": {
          "$ref": "#/$defs/TechLeadActivityContract"
        },
        "techLeadRuns": {
          "$ref": "#/$defs/TechLeadRunActionsContract"
        },
        "validationConfigured": {
          "title": "Validationconfigured",
          "type": "boolean"
        }
      },
      "required": [
        "startupComplete",
        "paused",
        "e2eRunning",
        "queueRefreshSeconds",
        "repo",
        "repoRoot",
        "githubOwner",
        "githubRepo",
        "agents",
        "validationConfigured",
        "providerCircuit",
        "techLeadRuns",
        "techLeadActivity"
      ],
      "title": "DashboardDataContract",
      "type": "object"
    },
    "ProviderCircuitEntryContract": {
      "additionalProperties": true,
      "description": "One provider's circuit row in the health panel (issue #5980).",
      "properties": {
        "consecutive_outages": {
          "title": "Consecutive Outages",
          "type": "integer"
        },
        "cooldown_remaining_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cooldown Remaining Label"
        },
        "is_open": {
          "title": "Is Open",
          "type": "boolean"
        },
        "last_error_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error Summary"
        },
        "next_retry_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Retry At"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "status_label": {
          "title": "Status Label",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "is_open",
        "status_label",
        "consecutive_outages"
      ],
      "title": "ProviderCircuitEntryContract",
      "type": "object"
    },
    "ProviderCircuitStatusContract": {
      "additionalProperties": true,
      "description": "Provider circuit-breaker status powering the outage banner + panel.\n\n``any_open`` is the single flag the banner gates on. ``summary_text`` is a\ncolour-independent one-liner (provider names + next retry) so the outage is\nlegible without relying on the banner's colour alone.",
      "properties": {
        "any_open": {
          "title": "Any Open",
          "type": "boolean"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/ProviderCircuitEntryContract"
          },
          "title": "Entries",
          "type": "array"
        },
        "next_retry_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Retry At"
        },
        "open_count": {
          "title": "Open Count",
          "type": "integer"
        },
        "open_providers": {
          "items": {
            "type": "string"
          },
          "title": "Open Providers",
          "type": "array"
        },
        "status_unavailable": {
          "default": false,
          "title": "Status Unavailable",
          "type": "boolean"
        },
        "summary_text": {
          "title": "Summary Text",
          "type": "string"
        }
      },
      "required": [
        "any_open",
        "open_count",
        "summary_text"
      ],
      "title": "ProviderCircuitStatusContract",
      "type": "object"
    },
    "TechLeadActivityContract": {
      "additionalProperties": true,
      "description": "The local tech-lead run history the dashboard shows (ADR-0033 / #6858).\n\nLocal by design: the run's existence and detail belong on the tool's own\ndashboard, while only the run's OUTPUT (its proposals) reaches the client's\nGitHub board.",
      "properties": {
        "emptyMessage": {
          "title": "Emptymessage",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/TechLeadRunActivityEntryContract"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "emptyMessage"
      ],
      "title": "TechLeadActivityContract",
      "type": "object"
    },
    "TechLeadRunActionsContract": {
      "additionalProperties": true,
      "description": "State powering the two scoped tech-lead dashboard actions (#6994).\n\nAdvisory affordance data only. ``POST /api/tech-lead/runs`` re-decides\nadmission server-side on every click, so these flags shape what the operator\nSEES, never what the engine allows.",
      "properties": {
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "globalBarrierActive": {
          "title": "Globalbarrieractive",
          "type": "boolean"
        },
        "globalBarrierNote": {
          "default": "",
          "title": "Globalbarriernote",
          "type": "string"
        },
        "globalStatus": {
          "title": "Globalstatus",
          "type": "string"
        },
        "globalStatusLabel": {
          "title": "Globalstatuslabel",
          "type": "string"
        },
        "healthReviewStatus": {
          "title": "Healthreviewstatus",
          "type": "string"
        },
        "healthReviewStatusLabel": {
          "title": "Healthreviewstatuslabel",
          "type": "string"
        },
        "needsSettings": {
          "default": false,
          "title": "Needssettings",
          "type": "boolean"
        },
        "paused": {
          "title": "Paused",
          "type": "boolean"
        },
        "queuedIssueNumbers": {
          "items": {
            "type": "integer"
          },
          "title": "Queuedissuenumbers",
          "type": "array"
        },
        "running": {
          "default": true,
          "title": "Running",
          "type": "boolean"
        },
        "runningIssueNumbers": {
          "items": {
            "type": "integer"
          },
          "title": "Runningissuenumbers",
          "type": "array"
        },
        "unavailableReason": {
          "default": "",
          "title": "Unavailablereason",
          "type": "string"
        }
      },
      "required": [
        "configured",
        "paused",
        "globalStatus",
        "globalStatusLabel",
        "healthReviewStatus",
        "healthReviewStatusLabel",
        "globalBarrierActive"
      ],
      "title": "TechLeadRunActionsContract",
      "type": "object"
    },
    "TechLeadRunActivityEntryContract": {
      "additionalProperties": true,
      "description": "One recorded tech-lead run on the activity panel (ADR-0033 / #6858).",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "endedAt": {
          "default": "",
          "title": "Endedat",
          "type": "string"
        },
        "findings": {
          "default": 0,
          "title": "Findings",
          "type": "integer"
        },
        "flavorLabel": {
          "title": "Flavorlabel",
          "type": "string"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "phaseLabel": {
          "title": "Phaselabel",
          "type": "string"
        },
        "proposals": {
          "default": 0,
          "title": "Proposals",
          "type": "integer"
        },
        "runId": {
          "title": "Runid",
          "type": "string"
        },
        "runKey": {
          "title": "Runkey",
          "type": "string"
        },
        "sessionName": {
          "title": "Sessionname",
          "type": "string"
        },
        "startedAt": {
          "title": "Startedat",
          "type": "string"
        },
        "subjectIssueNumber": {
          "default": 0,
          "title": "Subjectissuenumber",
          "type": "integer"
        },
        "subjectTitle": {
          "default": "",
          "title": "Subjecttitle",
          "type": "string"
        },
        "tone": {
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "runKey",
        "flavorLabel",
        "phase",
        "phaseLabel",
        "tone",
        "startedAt",
        "runId",
        "sessionName"
      ],
      "title": "TechLeadRunActivityEntryContract",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "active_tab": {
      "title": "Active Tab",
      "type": "string"
    },
    "dashboard_data": {
      "$ref": "#/$defs/DashboardDataContract"
    },
    "paused": {
      "title": "Paused",
      "type": "boolean"
    },
    "shutdown_requested": {
      "title": "Shutdown Requested",
      "type": "boolean"
    },
    "startup_status": {
      "title": "Startup Status",
      "type": "string"
    }
  },
  "required": [
    "dashboard_data",
    "paused",
    "startup_status",
    "active_tab",
    "shutdown_requested"
  ],
  "title": "DashboardViewModelContract",
  "type": "object"
}