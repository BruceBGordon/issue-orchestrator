# The container's personal pool (issue #7115, docs/architecture/execenv/).
# One machine, one trusted user, all five daemons on loopback. When io
# itself moves in-container (post ADR-0016), it joins DAEMON_LIST here
# as a non-DaemonCore daemon per ADR-0003.

CONDOR_HOST = 127.0.0.1
COLLECTOR_HOST = 127.0.0.1
NETWORK_INTERFACE = 127.0.0.1
BIND_ALL_INTERFACES = False
DAEMON_LIST = MASTER COLLECTOR NEGOTIATOR SCHEDD STARTD

# Run jobs as the submitting owner (single trusted user; without this
# jobs run as nobody and cannot enter 0700 working directories).
UID_DOMAIN = $(FULL_HOSTNAME)
TRUST_UID_DOMAIN = TRUE
STARTER_ALLOW_RUNAS_OWNER = TRUE

# One partitionable slot spanning the machine (ADR-0004): condor carves
# dynamic slots to each job's request_cpus/request_memory instead of
# static equal shares.
NUM_SLOTS = 1
NUM_SLOTS_TYPE_1 = 1
SLOT_TYPE_1 = 100%
SLOT_TYPE_1_PARTITIONABLE = TRUE

# THE reason this container exists (ADR-0001): cgroup-backed tracking
# and hard memory enforcement. A lane exceeding its declared
# request_memory is held with a limit-naming diagnosis, not
# advisory-scheduled.
CGROUP_MEMORY_LIMIT_POLICY = hard
# Without this, memory.max alone is NOT a ceiling on allocation: the
# VM has swap, and an over-limit allocation quietly swaps out and
# succeeds (observed live: 400MB survived a 128MB budget until swap
# was denied to jobs).
DISABLE_SWAP_FOR_JOB = true

# Lane compatibility, mirrored from scripts/condor-personal.sh's
# write_lane_config (fast negotiation for interactive gates, named
# concurrency limits as machine mutexes, precise periodic expressions,
# and no scratch bind-mount over /tmp — lanes must see the real
# filesystem).
NEGOTIATOR_INTERVAL = 1
NEGOTIATOR_CYCLE_DELAY = 1
NEGOTIATOR_MIN_INTERVAL = 1
SCHEDD_MIN_INTERVAL = 1
JOB_START_DELAY = 0
JOB_START_COUNT = 100
CLAIM_WORKLIFE = 3600
PERIODIC_EXPR_INTERVAL = 5
CONCURRENCY_LIMIT_DEFAULT = 1
MOUNT_UNDER_SCRATCH =
